#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <unistd.h>
#include <ctype.h>
#include <sys/stat.h>
#include <curl/curl.h>
#include <cjson/cJSON.h>

#define RESET "\033[0m"
#define CORAL "\033[38;5;173m"
#define GOLD  "\033[38;5;179m"
#define CREAM "\033[38;5;230m"
#define MUTED "\033[38;5;245m"
#define CLEAR "\033[2J\033[H"
#define DATA_FILE "data/films.txt"
#define MAX_RESULTS 5

typedef struct Film {
    int id;
    char title[100];
    char director[100];
    int year;
    float rating;
    struct Film *next;
} Film;

typedef struct {
    int tmdbId;
    char title[100];
    int year;
} Result;

typedef struct {
    char *data;
    size_t len;
} Buffer;

Film *head = NULL;
int nextId = 1;

/* ---------- utilities ---------- */

void pauseMs(long ms) {
    struct timespec delay = {ms / 1000, (ms % 1000) * 1000000L};
    nanosleep(&delay, NULL);
}

void line(void) {
    printf(CORAL "  ------------------------------------------------------------\n" RESET);
}

void flushInput(void) {
    int c;
    while ((c = getchar()) != '\n' && c != EOF) {}
}

/* ---------- storage ---------- */

void saveFilms(void) {
    FILE *file = fopen(DATA_FILE, "w");
    if (!file) {
        printf(CORAL "  Could not save films. Check data/ exists.\n" RESET);
        return;
    }

    for (Film *f = head; f; f = f->next)
        fprintf(file, "%d|%s|%s|%d|%.1f\n",
                f->id, f->title, f->director, f->year, f->rating);

    fclose(file);
}

void loadFilms(void) {
    FILE *file = fopen(DATA_FILE, "r");
    if (!file) return;

    char buffer[320];

    while (fgets(buffer, sizeof(buffer), file)) {
        Film *f = malloc(sizeof(*f));
        if (!f) break;

        if (sscanf(buffer, "%d|%99[^|]|%99[^|]|%d|%f",
                   &f->id, f->title, f->director,
                   &f->year, &f->rating) != 5) {
            free(f);
            continue;
        }

        f->next = NULL;

        if (!head) head = f;
        else {
            Film *p = head;
            while (p->next) p = p->next;
            p->next = f;
        }

        if (f->id >= nextId) nextId = f->id + 1;
    }

    fclose(file);
}

void appendFilm(Film *f) {
    if (!head) head = f;
    else {
        Film *p = head;
        while (p->next) p = p->next;
        p->next = f;
    }
    nextId++;
    saveFilms();
}

/* '|' is the field separator in the save file, so keep it out of text */
void stripPipes(char *s) {
    for (; *s; s++)
        if (*s == '|') *s = '-';
}

/* ---------- TMDB ---------- */

static size_t writeCb(void *ptr, size_t size, size_t nmemb, void *userdata) {
    Buffer *b = userdata;
    size_t n = size * nmemb;
    char *tmp = realloc(b->data, b->len + n + 1);
    if (!tmp) return 0;
    b->data = tmp;
    memcpy(b->data + b->len, ptr, n);
    b->len += n;
    b->data[b->len] = '\0';
    return n;
}

/* Fetch a URL and return parsed JSON (caller frees with cJSON_Delete), or NULL */
cJSON *tmdbFetch(const char *url) {
    CURL *curl = curl_easy_init();
    if (!curl) return NULL;

    Buffer buf = {0};
    curl_easy_setopt(curl, CURLOPT_URL, url);
    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, writeCb);
    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &buf);
    curl_easy_setopt(curl, CURLOPT_TIMEOUT, 10L);

    CURLcode rc = curl_easy_perform(curl);
    curl_easy_cleanup(curl);

    if (rc != CURLE_OK || !buf.data) {
        free(buf.data);
        return NULL;
    }

    cJSON *json = cJSON_Parse(buf.data);
    free(buf.data);
    return json;
}

int tmdbSearch(const char *query, Result *out) {
    const char *key = getenv("TMDB_API_KEY");
    if (!key) {
        printf(CORAL "  Set TMDB_API_KEY first (export TMDB_API_KEY=...).\n" RESET);
        return 0;
    }

    CURL *tmp = curl_easy_init();
    if (!tmp) return 0;
    char *encoded = curl_easy_escape(tmp, query, 0);
    char url[512];
    snprintf(url, sizeof url,
             "https://api.themoviedb.org/3/search/movie?api_key=%s&query=%s",
             key, encoded);
    curl_free(encoded);
    curl_easy_cleanup(tmp);

    cJSON *json = tmdbFetch(url);
    if (!json) {
        printf(CORAL "  TMDB request failed. Check your connection and key.\n" RESET);
        return 0;
    }

    int count = 0;
    cJSON *results = cJSON_GetObjectItem(json, "results");
    cJSON *item;
    cJSON_ArrayForEach(item, results) {
        if (count >= MAX_RESULTS) break;

        cJSON *id = cJSON_GetObjectItem(item, "id");
        cJSON *title = cJSON_GetObjectItem(item, "title");
        cJSON *date = cJSON_GetObjectItem(item, "release_date");
        if (!cJSON_IsNumber(id) || !cJSON_IsString(title)) continue;

        out[count].tmdbId = id->valueint;
        snprintf(out[count].title, sizeof out[count].title, "%s", title->valuestring);
        out[count].year = 0;
        if (cJSON_IsString(date)) sscanf(date->valuestring, "%d", &out[count].year);
        count++;
    }

    cJSON_Delete(json);
    return count;
}

int tmdbDirector(int tmdbId, char *out, size_t size) {
    const char *key = getenv("TMDB_API_KEY");
    if (!key) return 0;

    char url[256];
    snprintf(url, sizeof url,
             "https://api.themoviedb.org/3/movie/%d/credits?api_key=%s",
             tmdbId, key);

    cJSON *json = tmdbFetch(url);
    if (!json) return 0;

    int found = 0;
    cJSON *crew = cJSON_GetObjectItem(json, "crew");
    cJSON *person;
    cJSON_ArrayForEach(person, crew) {
        cJSON *job = cJSON_GetObjectItem(person, "job");
        cJSON *name = cJSON_GetObjectItem(person, "name");
        if (cJSON_IsString(job) && cJSON_IsString(name) &&
            strcmp(job->valuestring, "Director") == 0) {
            snprintf(out, size, "%s", name->valuestring);
            found = 1;
            break;
        }
    }

    cJSON_Delete(json);
    return found;
}

void addFromTMDB(void) {
    char query[100];
    Result results[MAX_RESULTS];

    printf("\n" GOLD "  ADD FROM TMDB\n" RESET);
    printf("  Search title: ");
    if (scanf(" %99[^\n]", query) != 1) return;

    int n = tmdbSearch(query, results);
    if (n == 0) {
        printf(MUTED "  No results.\n" RESET);
        return;
    }

    for (int i = 0; i < n; i++)
        printf(CREAM "  %d  %s (%d)\n" RESET, i + 1, results[i].title, results[i].year);

    int pick;
    printf("  Pick one (0 to cancel): ");
    if (scanf("%d", &pick) != 1) {
        flushInput();
        printf("  Invalid choice.\n");
        return;
    }
    if (pick < 1 || pick > n) return;

    Result *r = &results[pick - 1];

    Film *f = malloc(sizeof(*f));
    if (!f) {
        printf("  Memory allocation failed.\n");
        return;
    }

    f->id = nextId;
    f->next = NULL;
    f->year = r->year;
    snprintf(f->title, sizeof f->title, "%s", r->title);
    if (!tmdbDirector(r->tmdbId, f->director, sizeof f->director))
        snprintf(f->director, sizeof f->director, "Unknown");
    stripPipes(f->title);
    stripPipes(f->director);

    printf(MUTED "  %s | %s | %d\n" RESET, f->title, f->director, f->year);
    printf("  Your rating (0-10): ");
    if (scanf("%f", &f->rating) != 1 || f->rating < 0 || f->rating > 10) {
        flushInput();
        printf("  Rating must be between 0 and 10.\n");
        free(f);
        return;
    }

    appendFilm(f);
    printf(CORAL "\n  Filed away. Another story preserved.\n" RESET);
}

/* ---------- UI ---------- */

void showTitle(void) {
    printf(CLEAR);
    printf("\n\n");

    printf(CORAL "       o       o       o       o       o       o\n");
    printf("    .=================================================.\n");
    printf("    |                                                 |\n");
    printf("    '================================================='\n" RESET);

    pauseMs(250);

    printf("\n" GOLD);
    printf("   ██████╗██╗███╗   ██╗███████╗██████╗ ██╗  ██╗██╗██╗      ██╗ █████╗\n");
    printf("  ██╔════╝██║████╗  ██║██╔════╝██╔══██╗██║  ██║██║██║      ██║██╔══██╗\n");
    printf("  ██║     ██║██╔██╗ ██║█████╗  ██████╔╝███████║██║██║      ██║███████║\n");
    printf("  ██║     ██║██║╚██╗██║██╔══╝  ██╔══██╗██╔══██║██║██║      ██║██╔══██║\n");
    printf("  ╚██████╗██║██║ ╚████║███████╗██║  ██║██║  ██║██║███████╗██║██║  ██║\n");
    printf("   ╚═════╝╚═╝╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝╚══════╝╚═╝╚═╝  ╚═╝\n");
    printf(RESET);

    printf("\n" CORAL "              What is this world without art?\n" RESET);
    printf(MUTED "                AN ARCHIVE FOR THE LOVE OF FILM\n\n" RESET);

    const char *frames[] = {
        "  ( o ) ------------------------------ ( o )",
        "  ( O ) ============================== ( O )",
        "  ( 0 ) ------------------------------ ( 0 )",
        "  ( O ) ============================== ( O )"
    };

    for (int i = 0; i < 4; i++) {
        printf("\r" CORAL "%s" RESET, frames[i]);
        fflush(stdout);
        pauseMs(160);
    }

    printf("\n\n");
    line();
}

void browseArchive(void) {
    printf("\n" GOLD "  THE ARCHIVE\n" RESET);
    line();

    if (!head) {
        printf(MUTED "  The shelves are empty. Add your first film.\n" RESET);
        return;
    }

    for (Film *f = head; f; f = f->next) {
        printf(CREAM "  #%d  %s\n" RESET, f->id, f->title);
        printf(MUTED "      %s | %d | Rating: %.1f/10\n\n" RESET,
               f->director, f->year, f->rating);
    }
}

void addFilm(void) {
    Film *f = malloc(sizeof(*f));
    if (!f) {
        printf("  Memory allocation failed.\n");
        return;
    }

    f->id = nextId;
    f->next = NULL;

    printf("\n" GOLD "  ADD A FILM\n" RESET);
    printf("  Title: ");
    if (scanf(" %99[^\n]", f->title) != 1) { free(f); return; }

    printf("  Director: ");
    if (scanf(" %99[^\n]", f->director) != 1) { free(f); return; }

    printf("  Release year: ");
    if (scanf("%d", &f->year) != 1 || f->year < 1888 || f->year > 2100) {
        flushInput();
        printf("  Enter a valid year.\n");
        free(f);
        return;
    }

    printf("  Your rating (0-10): ");
    if (scanf("%f", &f->rating) != 1 ||
        f->rating < 0 || f->rating > 10) {
        flushInput();
        printf("  Rating must be between 0 and 10.\n");
        free(f);
        return;
    }

    stripPipes(f->title);
    stripPipes(f->director);

    appendFilm(f);
    printf(CORAL "\n  Filed away. Another story preserved.\n" RESET);
}

int containsIgnoreCase(const char *text, const char *query) {
    size_t length = strlen(query);
    if (!length) return 1;

    for (; *text; text++) {
        size_t i = 0;
        while (i < length && text[i] &&
               tolower((unsigned char)text[i]) ==
               tolower((unsigned char)query[i]))
            i++;

        if (i == length) return 1;
    }

    return 0;
}

void searchFilm(void) {
    char query[100];
    int found = 0;

    printf("\n  Search film title: ");
    if (scanf(" %99[^\n]", query) != 1) return;

    for (Film *f = head; f; f = f->next) {
        if (containsIgnoreCase(f->title, query)) {
            printf(CREAM "\n  #%d  %s\n" RESET, f->id, f->title);
            printf(MUTED "      %s | %d | %.1f/10\n" RESET,
                   f->director, f->year, f->rating);
            found = 1;
        }
    }

    if (!found) printf(MUTED "  No matching films found.\n" RESET);
}

void deleteFilm(void) {
    int id;

    printf("\n  Film ID to remove: ");
    if (scanf("%d", &id) != 1) {
        flushInput();
        printf("  Invalid ID.\n");
        return;
    }

    Film *current = head, *previous = NULL;

    while (current && current->id != id) {
        previous = current;
        current = current->next;
    }

    if (!current) {
        printf("  Film not found.\n");
        return;
    }

    if (!previous) head = current->next;
    else previous->next = current->next;

    printf(CORAL "  Removed: %s\n" RESET, current->title);
    free(current);
    saveFilms();
}

void randomPick(void) {
    if (!head) {
        printf("\n  Your archive is empty. Add a film first.\n");
        return;
    }

    int count = 0;
    for (Film *f = head; f; f = f->next) count++;

    int pick = rand() % count;
    Film *f = head;
    while (pick--) f = f->next;

    printf("\n" CORAL "  TONIGHT'S SCREENING\n" RESET);
    printf(GOLD "  * %s *\n" RESET, f->title);
    printf(MUTED "  Directed by %s (%d) | Rating: %.1f/10\n" RESET,
           f->director, f->year, f->rating);
}

void statistics(void) {
    int count = 0;
    float total = 0;

    for (Film *f = head; f; f = f->next) {
        count++;
        total += f->rating;
    }

    printf("\n" GOLD "  YOUR CINEMA, IN NUMBERS\n" RESET);
    printf("  Films archived: %d\n", count);

    if (count) printf("  Average rating: %.1f/10\n", total / count);
    else printf("  Average rating: --\n");
}

void displayMenu(void) {
    printf("\n");
    printf(CREAM "  1  Browse the archive\n");
    printf("  2  Add a film (manual)\n");
    printf("  3  Search the archive\n");
    printf("  4  Remove a film\n");
    printf("  5  After dark -- random pick\n");
    printf("  6  Your cinema in numbers\n");
    printf("  7  Add a film from TMDB\n");
    printf("  0  Leave quietly\n" RESET);

    line();
    printf("  Select an entry: ");
}

void freeArchive(void) {
    while (head) {
        Film *temp = head;
        head = head->next;
        free(temp);
    }
}

int main(void) {
    srand((unsigned int)time(NULL));
    curl_global_init(CURL_GLOBAL_DEFAULT);
    mkdir("data", 0755);   /* harmless if it already exists */
    loadFilms();
    showTitle();

    int choice;

    do {
        displayMenu();

        if (scanf("%d", &choice) != 1) {
            flushInput();
            choice = -1;
        }

        switch (choice) {
            case 1: browseArchive(); break;
            case 2: addFilm(); break;
            case 3: searchFilm(); break;
            case 4: deleteFilm(); break;
            case 5: randomPick(); break;
            case 6: statistics(); break;
            case 7: addFromTMDB(); break;
            case 0:
                printf(CORAL "\n  The credits roll. See you at the movies.\n" RESET);
                break;
            default:
                printf("  Choose a valid option.\n");
        }
    } while (choice != 0);

    saveFilms();
    freeArchive();
    curl_global_cleanup();
    return 0;
}
