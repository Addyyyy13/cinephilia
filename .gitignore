# Build products
/cinephilia
/build/
*.o
*.dSYM/

# Generated sound effects (recreated by `make`; see tools/gen_sounds.c)
/assets/audio/*.wav

# Personal data: your archive, its backups and your settings stay private
/data/*
!/data/.gitkeep
*.db
*.db.bak
*.db.tmp
*.db.damaged-*
settings.conf
!/examples/sample_archive.db

# Secrets, should a future TMDB integration be added
.env
.env.*
*.key

# Editors and operating systems
.DS_Store
.vscode/
.idea/
*.swp
*~

# Python caches from the test tools
__pycache__/
